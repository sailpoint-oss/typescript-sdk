{
  "name": "@sailpoint/api-client",
  "version": "2.2.8",
  "description": "Official library for using the SailPoint API",
  "author": "SailPoint DevOps",
  "repository": {
    "type": "git",
    "url": "https://github.com/sailpoint-oss/typescript-sdk.git"
  },
  "keywords": [
    "axios",
    "typescript",
    "sdk",
    "sailpoint"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/sailpoint-oss/typescript-sdk/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./dist/*.js": "./dist/*.js",
    "./dist/*.d.ts": "./dist/*.d.ts",
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "module": "./dist/esm/*.js",
      "import": "./dist/esm/*.js",
      "require": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "module": "./dist/esm/*.js",
      "import": "./dist/esm/*.js",
      "require": "./dist/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "dist/*": [
        "dist/*"
      ],
      "*": [
        "dist/*"
      ]
    }
  },
  "scripts": {
    "build": "tsc --outDir dist/ && tsc -p tsconfig.esm.json",
    "prepare": "npm run build",
    "test": "jest --ci",
    "build:cjs": "tsc --outDir dist/",
    "build:esm": "tsc -p tsconfig.esm.json"
  },
  "dependencies": {
    "axios": "^1.8.3",
    "axios-retry": "^3.4.0",
    "js-yaml": "^4.1.0",
    "proxy-agent": "^6.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^12.11.5",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^4.0"
  },
  "overrides": {
    "@babel/helpers": "^7.26.10",
    "@babel/runtime": "^7.26.10",
    "form-data": "^4.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "clearMocks": true,
    "collectCoverage": false,
    "testPathIgnorePatterns": [
      "/dist/",
      "/node_modules/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.*_v1/",
      "<rootDir>/generic/",
      "<rootDir>/nerm/",
      "<rootDir>/nermv2025/",
      "<rootDir>/dist/"
    ]
  },
  "sideEffects": [
    "**/dist/index.js",
    "**/dist/esm/index.js"
  ]
}
